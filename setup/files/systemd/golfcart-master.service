[Unit]
Description=Golf Cart master host stack
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/2026-golf-cart/scripts/multi_machine/master_unit_exec.sh
# Default KillMode=control-group is what makes the no-orphan guarantee hold: it
# kills every process play_launch spawned, not just the MainPID.
KillMode=control-group
# play_launch ignores SIGTERM (measured on the orin side: systemd's default stop
# sat in `deactivating` for the full TimeoutStopSec and then SIGKILLed the
# cgroup). SIGINT is the path play_launch actually handles.
KillSignal=SIGINT
# Sized for a multi-gigabyte bag flush; the orin's 30s covers its ~300MB bags but
# has never been tested against the master's 2GB+ ones.
#
# NOTE: whether this value fixes the 0-byte metadata.yaml roadblock is what
# Phase 0 of docs/design/orin_provisioning_implementation_plan.md measures. If
# play_launch's own shutdown grace is the binding constraint rather than the
# supervisor's, this has no effect and the roadblock needs a different fix.
TimeoutStopSec=180
# No Restart=: if the stack dies, an operator should notice, not have systemd
# silently paper over it.
Restart=no

[Install]
# Present so boot autostart is POSSIBLE (systemctl --user enable), but the
# installer does not enable it. The orin unit keeps no [Install] at all: it must
# only ever be started by the master.
WantedBy=default.target
