[Unit]
Description=Iceoryx RouDi shared-memory daemon (CycloneDDS zero-copy)
# Every ROS process on this host depends on RouDi once <SharedMemory><Enable>
# is true in the CycloneDDS profiles, so this unit must be up before any of
# them. The dependency is declared on the CONSUMER side (Requires=/After= in
# golfcart-launch.service and golfcart-record.service) rather than with a
# Before= here, so that starting RouDi alone stays harmless.
#
# Not tied to network-online.target: RouDi is purely local shared memory and
# has nothing to wait for.

[Service]
Type=simple
# %h/2026-golf-cart is the fallback for an unprovisioned checkout only; the
# installer's drop-in resets and replaces this with the resolved repo path.
ExecStart=%h/2026-golf-cart/scripts/iceoryx/roudi_unit_exec.sh
# RouDi releases /dev/shm/iceoryx_mgmt, /tmp/roudi and the lock files on a clean
# SIGTERM. Killing it harder leaves those behind, and a stale segment makes the
# next start fail rather than merely restart.
KillSignal=SIGTERM
KillMode=control-group
TimeoutStopSec=20
# Restart=on-failure, unlike the launch unit's Restart=no. The reasoning differs
# because the failure mode differs: a dead stack should be noticed by an
# operator, but a dead RouDi silently HANGS every node that later tries to
# create a participant, with no error anywhere. Recovering automatically is
# strictly better than that.
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
