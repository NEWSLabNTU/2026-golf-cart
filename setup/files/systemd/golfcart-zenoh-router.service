[Unit]
Description=Zenoh router (rmw_zenoh discovery, GOLFCART_RMW=zenoh)
# Every ROS process on this host depends on this router once GOLFCART_RMW=zenoh,
# so it must be up before any of them. The dependency is declared on the CONSUMER
# side (Requires=/After= in golfcart-launch.service and golfcart-record.service)
# rather than with a Before= here, so that starting the router alone stays
# harmless -- the same split iox-roudi.service uses.
#
# Unlike RouDi, this one DOES want the network: the master's router accepts the
# orin's connection on 192.168.125.100:7447, and the orin's router dials out to
# it. Binding before the interface is configured would leave the listener on a
# socket the far side cannot reach.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# %h/2026-golf-cart is the fallback for an unprovisioned checkout only; the
# installer's drop-in resets and replaces this with the resolved repo path.
ExecStart=%h/2026-golf-cart/scripts/zenoh/router_unit_exec.sh
KillSignal=SIGTERM
KillMode=control-group
TimeoutStopSec=10
# Restart=on-failure, matching iox-roudi.service and for the same reason: the
# failure mode of a dead router is silent. Nodes do not crash when it goes away,
# they simply stop discovering each other, and a stack that is "up" but blind is
# far worse to hand an operator than one that restarted itself.
#
# Restarting is genuinely safe here: the router holds no state that the sessions
# depend on. Peers reconnect on their own (connect.retry caps at 4 s) and
# re-gossip what they know, and links that were already established between peers
# are not torn down by the router going away -- it is the discovery path, not the
# data path. That last part is specific to the peer-mesh topology in
# config/zenoh/; it would not be true if the nodes were in client mode.
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
