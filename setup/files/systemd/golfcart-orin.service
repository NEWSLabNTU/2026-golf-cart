[Unit]
Description=Golf Cart orin (slave) host stack
# Started on demand by the master over ssh (scripts/multi_machine/orin_remote.sh),
# never at boot - hence no [Install] section. `systemctl --user enable` on this
# unit is a mistake: the orin would launch the ZED with no master to talk to.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/2026-golf-cart/scripts/multi_machine/orin_unit_exec.sh
# Default KillMode=control-group is what makes the no-orphan guarantee hold: it
# kills every process play_launch spawned, not just the MainPID.
KillMode=control-group
# play_launch needs a moment to stop its children and let recorders finalize
# their bags; SIGKILL before that truncates the bag metadata.
TimeoutStopSec=30
# No Restart=: if the stack dies, the master should notice, not have systemd
# silently paper over it.
Restart=no
