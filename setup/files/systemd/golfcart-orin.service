[Unit]
Description=Golf Cart orin (slave) host stack
# Started on demand by the master over ssh (scripts/multi_machine/orin_remote.sh),
# never at boot - hence no [Install] section. `systemctl --user enable` on this
# unit is a mistake: the orin would launch the ZED with no master to talk to.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/2026-golf-cart/scripts/multi_machine/orin_unit_exec.sh
# Default KillMode=control-group is what makes the no-orphan guarantee hold: it
# kills every process play_launch spawned, not just the MainPID.
KillMode=control-group
# play_launch ignores SIGTERM. Measured: systemd's default stop sat in
# `deactivating` for the full TimeoutStopSec and then SIGKILLed the cgroup,
# leaving the unit `failed (Result: timeout)` - and a SIGKILLed `ros2 bag` does
# not write its metadata.yaml, so recordings would be lost. SIGINT is the path
# play_launch actually handles (the same one Ctrl-C uses); with it the unit stops
# cleanly in ~12s.
KillSignal=SIGINT
# Room for that graceful stop, with SIGKILL as the backstop if it ever hangs.
TimeoutStopSec=30
# No Restart=: if the stack dies, the master should notice, not have systemd
# silently paper over it.
Restart=no
