[Unit]
Description=Golf Cart rosbag recorder
# Deliberately NOT tied to golfcart-launch.service by PartOf/BindsTo/Requires.
# Recording has its own lifecycle: it must be startable against an already
# running stack, stoppable without stopping it, and it must survive a launch
# restart. Coupling the two is what put the recorder under play_launch's
# shutdown in the first place, which is where the 0-byte metadata.yaml came from.
After=network-online.target
# Ordering only, deliberately Wants= and not Requires=. Shared memory is
# currently DISABLED in the CycloneDDS profiles (iceoryx runs out of publisher
# ports on a stack this size - see config/cyclonedds/master.xml), so RouDi is
# not on the critical path and a RouDi failure must not take the stack with it.
# If <SharedMemory> is ever re-enabled after rebuilding iceoryx with a raised
# IOX_MAX_PUBLISHERS, change this to Requires=: with SHM on and RouDi absent,
# participant creation hangs forever with no message rather than failing.
Wants=iox-roudi.service
After=iox-roudi.service
# The Zenoh router, for GOLFCART_RMW=zenoh. Wants= and not Requires= for a
# reason specific to this unit: router_unit_exec.sh deliberately EXITS 1 when
# GOLFCART_RMW is cyclonedds, because there is nothing for it to run. Under
# Requires= that by-design refusal would fail the stack on every CycloneDDS
# boot. The hard gate lives where it can be conditional instead --
# launch_unit_exec.sh calls scripts/rmw/ensure.sh, which only insists on a
# router when this host is actually on zenoh.
Wants=golfcart-zenoh-router.service
After=golfcart-zenoh-router.service
Wants=network-online.target

[Service]
Type=simple
# See golfcart-launch.service: the installer's drop-in replaces this with the
# resolved absolute path.
ExecStart=%h/2026-golf-cart/scripts/recording/record_unit_exec.sh
KillMode=control-group
# `ros2 bag record` writes metadata.yaml during its SIGINT shutdown. A SIGKILLed
# recorder leaves a 0-byte metadata.yaml and an unreadable bag, so the signal
# matters more here than anywhere else in the stack.
KillSignal=SIGINT
# Generous: this is now the only place bag finalization happens, and closing a
# multi-gigabyte bag (index + metadata over an external SSD) is the one stop in
# the system that legitimately takes minutes. Overshooting costs a slow
# `record-stop`; undershooting costs the recording.
TimeoutStopSec=300
# No Restart=: a recorder that died mid-bag must not silently start a second one
# under a new URI - that splits a run across bags nobody knows to merge.
Restart=no

[Install]
WantedBy=default.target
