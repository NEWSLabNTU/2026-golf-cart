<?xml version="1.0"?>
<!--
  Phase 3D-6 stage 1: the whole ArUco localization stack against synthetic
  detections, with no Autoware simulator and no map.

  What this exercises that the aruco_sim_detector bench does not: the real D2
  launch graph, gyro_odometer, the EKF, the health monitors, and the
  diagnostics graph. The detector is the only substituted component, and it
  publishes on the same topics the real ones do, so nothing downstream can
  tell the difference.

  Runs in seconds. Evaluate with scripts/check/aruco_smoke_test.py.
-->
<launch>
  <arg name="pattern" default="straight"
       description="static, straight, circle or corridor"/>
  <arg name="speed" default="1.0"/>
  <arg name="radius" default="4.0" description="circle and corridor turn radius"/>
  <arg name="corner_sigma_px" default="0.3"/>

  <arg name="tag_map_path"
       default="$(find-pkg-share aruco_sim_detector)/config/bench_tag_map.yaml"/>
  <arg name="loc_config_path"
       default="$(find-pkg-share golfcart_launch)/config/localization"/>

  <!-- Fault injection. Each maps to a check in the phase doc. -->
  <arg name="blackout" default="false"
       description="stop emitting detections: DEAD_RECKONING, then FAULT on budget expiry"/>
  <arg name="blackout_start" default="0.0"
       description="seconds of normal operation before the blackout begins"/>
  <arg name="displaced_board_id" default="-1"
       description="move one board off its map entry: integrity must flag that ID alone"/>
  <arg name="displacement" default="[0.0, 0.0, 0.0]"
       description="how far to move it; displacing by zero is not a fault"/>
  <arg name="stamp_offset_s" default="0.0"
       description="push stamps into the future: clock-skew rejection"/>

  <!-- Ground truth, plus the IMU and wheel speed the EKF needs. Without those
       the fused pose never moves between ArUco fixes and the dead-reckoning
       states cannot be exercised at all. -->
  <node pkg="aruco_sim_detector" exec="sim_trajectory_publisher_node"
        name="sim_trajectory_publisher" output="screen">
    <param name="pattern" value="$(var pattern)"/>
    <param name="speed" value="$(var speed)"/>
    <param name="radius" value="$(var radius)"/>
    <remap from="~/output/ground_truth" to="/simulation/ground_truth/kinematic_state"/>
    <remap from="~/output/imu" to="/sensing/imu/imu_data"/>
    <remap from="~/output/velocity"
           to="/sensing/vehicle_velocity_converter/twist_with_covariance"/>
  </node>

  <include file="$(find-pkg-share golfcart_launch)/launch/components/aruco_localization.launch.xml">
    <arg name="loc_config_path" value="$(var loc_config_path)"/>
    <arg name="aruco_tag_map_path" value="$(var tag_map_path)"/>
    <arg name="use_sim_detector" value="true"/>
    <arg name="sim_corner_sigma_px" value="$(var corner_sigma_px)"/>
    <arg name="sim_blackout" value="$(var blackout)"/>
    <arg name="sim_blackout_start_s" value="$(var blackout_start)"/>
    <arg name="sim_displaced_board_id" value="$(var displaced_board_id)"/>
    <arg name="sim_displacement" value="$(var displacement)"/>
    <arg name="sim_stamp_offset_s" value="$(var stamp_offset_s)"/>
  </include>
</launch>
