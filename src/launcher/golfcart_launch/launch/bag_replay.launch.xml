<launch>
  <!--
    Replay a recorded bag with RViz.

    The bag carries sensor data but no usable TF: only two or three tf_static
    messages are recorded, and rosbag2 does not republish them with the
    transient-local QoS that subscribers expect, so nothing receives them. The
    LiDAR clouds are stamped in `velodyne` and `seyond`, which without a TF tree
    RViz cannot place at all.

    robot_state_publisher therefore rebuilds the tree from the vehicle and sensor
    kit description, which is also more trustworthy than the recording: it always
    reflects the current calibration files rather than whatever was installed on
    the day the bag was made.
  -->
  <arg name="bag" description="Path to the bag directory to replay"/>
  <arg name="rate" default="1.0" description="Playback rate multiplier"/>
  <arg name="start_offset" default="0.0"
       description="Seconds to skip. A merged bag opens with ~35s of orin-only data, because the orin starts recording before the master finishes its launch dump; skip past it to see both hosts at once."/>
  <arg name="play_args" default="" description="Extra ros2 bag play flags, e.g. --loop"/>

  <arg name="vehicle_model" default="golfcart_vehicle"/>
  <arg name="sensor_model" default="golfcart_sensor_kit"/>
  <arg name="rviz" default="true"/>
  <arg name="rviz_config" default="$(find-pkg-share golfcart_launch)/rviz/replay.rviz"/>

  <!-- Everything below reads the bag's clock, published by the player. -->
  <node name="robot_state_publisher" pkg="robot_state_publisher" exec="robot_state_publisher">
    <param name="use_sim_time" value="true"/>
    <param name="robot_description"
           value="$(command 'xacro $(find-pkg-share tier4_vehicle_launch)/urdf/vehicle.xacro vehicle_model:=$(var vehicle_model) sensor_model:=$(var sensor_model)' 'warn')"/>
  </node>

  <!--
    Only the compressed ZED stream is recorded, and RViz's Image display did not
    subscribe to it through its transport hint - the compressed topic showed zero
    subscribers with the display enabled. Decompressing here is explicit and
    verifiable: republish produces a plain sensor_msgs/Image that any display
    handles, at the cost of one decode per frame during replay only.
  -->
  <node name="zed_republish" pkg="image_transport" exec="republish"
        args="compressed raw" if="$(var rviz)">
    <param name="use_sim_time" value="true"/>
    <remap from="in/compressed" to="/sensing/camera/zed/rgb/color/rect/image/compressed"/>
    <remap from="out" to="/replay/zed/image"/>
  </node>

  <node name="rviz2" pkg="rviz2" exec="rviz2" if="$(var rviz)"
        args="-d $(var rviz_config)" output="screen">
    <param name="use_sim_time" value="true"/>
  </node>

  <!--
    Plain `ros2 launch` runs `executable` actions normally. Note this file must
    NOT be started through play_launch, which executes such actions during its
    dump phase and then drops them from the replay - see the Amendments section
    of docs/design/multi_machine_deployment.md.
  -->
  <executable
    cmd="ros2 bag play $(var bag) --clock --rate $(var rate) --start-offset $(var start_offset) $(var play_args)"
    output="screen" shell="true"/>
</launch>
