<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <!-- Golf Cart wrapper for autoware.launch.xml -->
  <!-- Uses golfcart_launch config instead of autoware_launch -->

  <!-- Essential parameters -->
  <arg name="map_path" description="point cloud and lanelet2 map directory path"/>
  <arg name="vehicle_model" default="sample_vehicle" description="vehicle model name"/>
  <arg name="sensor_model" default="sample_sensor_kit" description="sensor model name"/>
  <arg name="pointcloud_container_name" default="pointcloud_container"/>
  <arg name="data_path" default="$(env HOME)/autoware_data" description="packages data and artifacts directory path"/>

  <!-- launch module preset -->
  <arg name="planning_module_preset" default="default" description="planning module preset"/>
  <arg name="control_module_preset" default="default" description="control module preset"/>

  <!-- Optional parameters -->
  <!-- Modules to be launched -->
  <arg name="launch_vehicle" default="true" description="launch vehicle"/>
  <arg name="launch_system" default="true" description="launch system"/>
  <arg name="launch_map" default="true" description="launch map"/>
  <arg name="launch_sensing" default="true" description="launch sensing"/>
  <arg name="launch_sensing_driver" default="true" description="launch sensing driver"/>
  <arg name="launch_localization" default="true" description="launch localization"/>
  <arg name="launch_perception" default="true" description="launch perception"/>
  <arg name="launch_planning" default="true" description="launch planning"/>
  <arg name="launch_control" default="true" description="launch control"/>
  <arg name="launch_api" default="true" description="launch api"/>
  <!-- Global parameters -->
  <arg name="use_sim_time" default="false" description="use_sim_time"/>
  <!-- Vehicle -->
  <arg name="vehicle_id" default="$(env VEHICLE_ID default)" description="vehicle specific ID"/>
  <arg name="launch_vehicle_interface" default="true" description="launch vehicle interface"/>
  <!-- Control -->
  <arg name="check_external_emergency_heartbeat" default="false"/>
  <!-- Map -->
  <arg name="lanelet2_map_file" default="lanelet2_map.osm" description="lanelet2 map file name"/>
  <arg name="pointcloud_map_file" default="pointcloud_map.pcd" description="pointcloud map file name"/>
  <!-- System -->
  <arg name="system_run_mode" default="online" description="run mode in system"/>
  <arg name="launch_system_monitor" default="true" description="launch system monitor"/>
  <arg name="launch_dummy_diag_publisher" default="false" description="launch dummy diag publisher"/>
  <arg name="diagnostic_graph_aggregator_graph_path" default="$(find-pkg-share autoware_launch)/config/system/diagnostics/autoware-main.yaml" description="diagnostic graph config"/>
  <!-- Tools -->
  <arg name="rviz" default="true" description="launch rviz"/>
  <arg name="rviz_config_name" default="autoware.rviz" description="rviz config name"/>
  <arg name="rviz_config" default="$(find-pkg-share autoware_launch)/rviz/$(var rviz_config_name)" description="rviz config path"/>
  <arg name="rviz_respawn" default="true"/>
  <!-- Perception -->
  <arg name="perception_mode" default="lidar" description="select perception mode. camera_lidar_radar_fusion, camera_lidar_fusion, lidar_radar_fusion, lidar, radar"/>
  <arg name="traffic_light_recognition/enable_fine_detection" default="true" description="enable traffic light fine detection"/>
  <!-- Auto mode setting-->
  <arg name="enable_all_modules_auto_mode" default="false" description="enable all module's auto mode"/>
  <arg name="is_simulation" default="false" description="Autoware's behavior will change depending on whether this is a simulation or not."/>

  <!-- Global parameters -->
  <group scoped="false">
    <include file="$(find-pkg-share autoware_global_parameter_loader)/launch/global_params.launch.py">
      <arg name="use_sim_time" value="$(var use_sim_time)"/>
      <arg name="vehicle_model" value="$(var vehicle_model)"/>
    </include>
  </group>

  <!-- Pointcloud container -->
  <include file="$(find-pkg-share autoware_launch)/launch/pointcloud_container.launch.py">
    <arg name="use_multithread" value="true"/>
    <arg name="container_name" value="$(var pointcloud_container_name)"/>
  </include>

  <!-- Vehicle -->
  <group if="$(var launch_vehicle)">
    <include file="$(find-pkg-share tier4_vehicle_launch)/launch/vehicle.launch.xml">
      <arg name="vehicle_model" value="$(var vehicle_model)"/>
      <arg name="sensor_model" value="$(var sensor_model)"/>
      <arg name="vehicle_id" value="$(var vehicle_id)"/>
      <arg name="launch_vehicle_interface" value="$(var launch_vehicle_interface)"/>
      <arg name="config_dir" value="$(find-pkg-share individual_params)/config/$(var vehicle_id)/$(var sensor_model)"/>
      <!-- Golf Cart: Use golfcart_launch config for vehicle parameters -->
      <arg name="raw_vehicle_cmd_converter_param_path" value="$(find-pkg-share golfcart_launch)/config/vehicle/raw_vehicle_cmd_converter/raw_vehicle_cmd_converter.param.yaml"/>
    </include>
  </group>

  <!-- System -->
  <group if="$(var launch_system)">
    <!-- The graph path was declared above and never passed in, so the aggregator
         silently used its own upstream default and this argument did nothing.

         It matters for ArUco specifically: upstream's graph requires the NDT
         scan matcher's diagnostic, which never publishes on this path, leaving
         the whole localization subtree stale — reporting a fault while the
         vehicle localizes fine, and reporting the same when it does not. -->
    <let name="resolved_diagnostic_graph_path"
         value="$(find-pkg-share golfcart_launch)/config/system/diagnostics/autoware-main-aruco.yaml"
         if="$(eval '\'$(var pose_source)\' == \'aruco\'')"/>
    <let name="resolved_diagnostic_graph_path"
         value="$(var diagnostic_graph_aggregator_graph_path)"
         unless="$(eval '\'$(var pose_source)\' == \'aruco\'')"/>
    <!-- Ours, not autoware_launch's: it drops the three system monitors that
         cannot succeed on an Orin and points net_monitor at a device list
         instead of ["*"]. See that file and docs/known-config-defects.md. -->
    <include file="$(find-pkg-share golfcart_launch)/launch/components/tier4_system_component.launch.xml">
      <arg name="diagnostic_graph_aggregator_graph_path"
           value="$(var resolved_diagnostic_graph_path)"/>
    </include>
  </group>

  <!-- Map -->
  <group if="$(var launch_map)">
    <!--
      pose_source:=aruco has no point cloud map. tier4_map_component composes
      the pointcloud map loader unconditionally, so that path needs its own
      component. See golfcart_map_component.launch.xml.
    -->
    <group if="$(eval '\'$(var pose_source)\' == \'aruco\'')">
      <include file="$(find-pkg-share golfcart_launch)/launch/components/golfcart_map_component.launch.xml">
        <arg name="map_path" value="$(var map_path)"/>
        <arg name="lanelet2_map_file" value="$(var lanelet2_map_file)"/>
      </include>
    </group>
    <group unless="$(eval '\'$(var pose_source)\' == \'aruco\'')">
      <include file="$(find-pkg-share autoware_launch)/launch/components/tier4_map_component.launch.xml"/>
    </group>
  </group>

  <!-- Sensing -->
  <group if="$(var launch_sensing)">
    <include file="$(find-pkg-share autoware_launch)/launch/components/tier4_sensing_component.launch.xml">
      <arg name="pointcloud_container_name" value="$(var pointcloud_container_name)"/>
      <arg name="launch_sensing_driver" value="$(var launch_sensing_driver)"/>
      <arg name="sensor_model" value="$(var sensor_model)"/>
      <arg name="use_sim_time" value="$(var use_sim_time)"/>
      <arg name="vehicle_model" value="$(var vehicle_model)"/>
    </include>
  </group>

  <!-- Localization -->
  <!--
    Seed pose for a replay. Empty means "no seed", and the pose initializer then
    waits on GNSS or on the align service. tier4_localization_launch enables
    user_defined_initial_pose only when this is a 7-element list, so any other
    value is inert rather than wrong.

    It exists because without it a bag whose site has no captured pose has no
    way to start: the localization component below already accepted the argument
    and forwarded it, but nothing above ever passed one, so the scan matcher ran
    from an arbitrary prior and produced a flailing trajectory that still looked
    like output. The Autoware sample bag starts at
    [89571.0, 42301.0, -3.3, 0.0, 0.0, 0.28, 0.96].
  -->
  <arg name="initial_pose" default="[]"
       description="x, y, z, qx, qy, qz, qw. A 7-element list seeds the pose; anything else is ignored"/>

  <!--
    Which node seeds /localization/initialize. Orthogonal to pose_source, which
    names what TRACKS afterwards: `board` composes with ndt and cuda_ndt alike,
    which is why this is not a sixth pose_source value (roadmap phase 7, C2).

      gnss   Autoware's own GNSS-seeded initializer. The default; every
             existing invocation is unchanged and neither board node starts.
      board  reflective_pose_detector: the VLP-32C finds the retroreflective
             board, board_pose_initializer calls the service with the pose.
             Needs a map anchored to that board (data/basement-indoor).
      none   nothing seeds it. Manual init: RViz 2D Pose Estimate, or an
             /initialpose3d publish.

    Anything but gnss forces the pose initializer's gnss_enabled off, whatever
    use_gnss says. That is the whole of "replacing the GNSS initializer": with
    gnss_enabled false Autoware's pose_initializer waits on the service instead
    of on a GNSS fix that never comes, and the board node is what calls it.
  -->
  <arg name="pose_initializer" default="gnss"
       description="what seeds /localization/initialize: gnss | board | none"/>
  <!-- A directory under config/localization/reflective_pose/scenarios/, the
       same shape as perception_preset. detector.yaml in it is what the
       detector looks for; the wiring and policy files beside scenarios/ are
       per vehicle, not per site. -->
  <arg name="reflective_pose_scenario" default="basement"
       description="scenarios/NAME/detector.yaml for pose_initializer:=board"/>
  <!--
    The cloud the board detector reads. The VLP-32C's RAW driver output, on
    purpose, and it is the same topic name the D1a replay bag carries:

      /sensing/lidar/vlp32/velodyne_points   frame `velodyne`, PointXYZIRCAEDT
                                             with the intensity field intact

    Not the preprocessed per-LiDAR output (vlp32/pointcloud_before_sync) and
    not the concatenated cloud: both leave the sensor kit's crop box already
    transformed into base_link, and the detector's sensor_frame is `velodyne`,
    which must equal the cloud's header.frame_id. The detector stacks scans
    only while the cart is stationary, so the distortion correction it forgoes
    by taking the raw topic is worth nothing to it.
  -->
  <arg name="board_input_pointcloud" default="/sensing/lidar/vlp32/velodyne_points"
       description="PointCloud2 with intensity, in the detector's sensor_frame"/>
  <arg name="use_gnss" default="true" description="GNSS present on this run"/>
  <!-- gnss_enabled for the pose initializer. tier4_localization_component
       declares it with default $(var use_gnss); setting it here first means
       that default is never consulted, so the derived value wins in every
       branch (ndt, cuda_ndt, and the stock tier4 path). Lower-case strings,
       not Python booleans: it ends up both as a node parameter and in `if`
       conditions downstream. -->
  <let name="gnss_enabled"
       value="$(eval &quot;'true' if ('$(var pose_initializer)' == 'gnss' and '$(var use_gnss)'.lower() in ('true', '1', 'yes')) else 'false'&quot;)"/>

  <!-- Golf Cart: Use golfcart_launch's localization component with custom config -->
  <group if="$(var launch_localization)">
    <include file="$(find-pkg-share golfcart_launch)/launch/components/tier4_localization_component.launch.xml">
      <arg name="initial_pose" value="$(var initial_pose)"/>
      <arg name="gnss_enabled" value="$(var gnss_enabled)"/>
    </include>

    <!-- Board cold start, beside the localization component rather than
         under it. Included from THIS file so config_file and the two param
         files reach the nodes as arguments; an installed Autoware include
         between here and the nodes would drop them (CLAUDE.md, the
         camera_model / imu_source story), and the env-var route is the
         fallback if this ever has to move. Nodes come up as
         /localization/board_detector and /localization/board_pose_initializer. -->
    <group if="$(eval '\'$(var pose_initializer)\' == \'board\'')">
      <let name="reflective_pose_config_path"
           value="$(find-pkg-share golfcart_launch)/config/localization/reflective_pose"/>
      <include file="$(find-pkg-share reflective_pose_autoware)/launch/board_pose_initializer.launch.xml">
        <arg name="config_file" value="$(var reflective_pose_config_path)/scenarios/$(var reflective_pose_scenario)/detector.yaml"/>
        <arg name="detector_params_file" value="$(var reflective_pose_config_path)/board_detector.param.yaml"/>
        <arg name="initializer_params_file" value="$(var reflective_pose_config_path)/board_pose_initializer.param.yaml"/>
        <arg name="input_topic" value="$(var board_input_pointcloud)"/>
        <arg name="namespace" value="/localization"/>
      </include>
    </group>
  </group>

  <!-- Perception -->
  <group if="$(var launch_perception)">
    <include file="$(find-pkg-share autoware_launch)/launch/components/tier4_perception_component.launch.xml">
      <arg name="data_path" value="$(var data_path)"/>
      <arg name="pointcloud_container_name" value="$(var pointcloud_container_name)"/>
    </include>
  </group>

  <!-- Planning -->
  <group if="$(var launch_planning)">
    <include file="$(find-pkg-share autoware_launch)/launch/components/tier4_planning_component.launch.xml">
      <arg name="module_preset" value="$(var planning_module_preset)"/>
      <arg name="enable_all_modules_auto_mode" value="$(var enable_all_modules_auto_mode)"/>
      <arg name="is_simulation" value="$(var is_simulation)"/>
      <arg name="use_sim_time" value="$(var use_sim_time)"/>
      <arg name="vehicle_model" value="$(var vehicle_model)"/>
    </include>

    <!-- Relay node for trajectory topic -->
    <!-- This is a temporary addition for migration purposes. -->
    <!-- https://github.com/orgs/autowarefoundation/discussions/5033#discussioncomment-13704802 -->
    <node pkg="topic_tools" exec="relay" name="trajectory_relay">
      <param name="input_topic" value="/planning/trajectory"/>
      <param name="output_topic" value="/planning/scenario_planning/trajectory"/>
    </node>
  </group>

  <!-- Control -->
  <group if="$(var launch_control)">
    <include file="$(find-pkg-share autoware_launch)/launch/components/tier4_control_component.launch.xml">
      <arg name="module_preset" value="$(var control_module_preset)"/>
      <arg name="use_sim_time" value="$(var use_sim_time)"/>
      <arg name="vehicle_model" value="$(var vehicle_model)"/>
    </include>
  </group>

  <!-- API -->
  <group if="$(var launch_api)">
    <include file="$(find-pkg-share autoware_launch)/launch/components/tier4_autoware_api_component.launch.xml">
      <arg name="use_sim_time" value="$(var use_sim_time)"/>
      <arg name="vehicle_model" value="$(var vehicle_model)"/>
    </include>
  </group>

  <!-- Tools -->
  <group>
    <node
      pkg="rviz2"
      exec="rviz2"
      name="rviz2"
      output="screen"
      args="-d $(var rviz_config) -s $(find-pkg-share autoware_launch)/rviz/image/autoware.png"
      if="$(var rviz)"
      respawn="$(var rviz_respawn)"
    >
      <env name="QT_QPA_PLATFORMTHEME" value="qt5ct"/>
    </node>
  </group>
</launch>
