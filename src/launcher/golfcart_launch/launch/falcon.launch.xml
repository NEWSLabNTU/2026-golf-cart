<launch>
  <!--
    Standalone Falcon (Seyond) LiDAR driver.

    Lifted out of golfcart_sensor_kit_launch/launch/lidar.launch.xml so it can be
    launched on a different machine than the rest of the stack (host:=orin).
    The nested namespaces reproduce the ones that lidar.launch.xml used to apply
    via tier4_sensing_launch, so topic names stay at /sensing/lidar/falcon/*.
  -->
  <group>
    <push-ros-namespace namespace="sensing"/>
    <group>
      <push-ros-namespace namespace="lidar"/>
      <group>
        <push-ros-namespace namespace="falcon"/>
        <include file="$(find-pkg-share golfcart_sensor_kit_launch)/launch/seyond_start.py"/>
      </group>
    </group>
  </group>
</launch>
