<?xml version="1.0"?>
<!--
  Autoware's planning simulator with a golfcart planning preset (Phase 8, M2/M3).

  autoware_launch's planning_simulator.launch.xml, unchanged, with its planning
  component swapped for ours: launch_planning is set false before the include,
  which autoware.launch.xml's own default does not override, and our copy of
  tier4_planning_component is included beside it with planning_preset. Upstream
  cannot be told to do this from outside: its planning_module_preset names a
  file inside autoware_launch, and every parameter file path in its planning
  component is fixed.

  planning_preset:=default is the stock planning simulator, module for module.
-->
<launch>
  <arg name="map_path" description="lanelet2 and pointcloud map directory"/>
  <arg name="lanelet2_map_file" default="lanelet2_map.osm"/>
  <arg name="vehicle_model" default="golfcart_vehicle"/>
  <arg name="sensor_model" default="golfcart_sensor_kit"/>
  <arg name="planning_preset" default="default" description="file in golfcart_launch/config/planning/preset/: default, slow_indoor"/>
  <arg name="rviz" default="true"/>

  <let name="launch_planning" value="false"/>
  <include file="$(find-pkg-share autoware_launch)/launch/planning_simulator.launch.xml">
    <arg name="map_path" value="$(var map_path)"/>
    <arg name="lanelet2_map_file" value="$(var lanelet2_map_file)"/>
    <arg name="vehicle_model" value="$(var vehicle_model)"/>
    <arg name="sensor_model" value="$(var sensor_model)"/>
    <arg name="rviz" value="$(var rviz)"/>
  </include>

  <!-- What autoware.launch.xml's planning group does, with our component. -->
  <group>
    <include file="$(find-pkg-share golfcart_launch)/launch/components/tier4_planning_component.launch.xml">
      <arg name="module_preset" value="$(var planning_preset)"/>
      <arg name="enable_all_modules_auto_mode" value="false"/>
      <arg name="is_simulation" value="true"/>
      <arg name="use_sim_time" value="false"/>
      <arg name="vehicle_model" value="$(var vehicle_model)"/>
      <arg name="pointcloud_container_name" value="pointcloud_container"/>
    </include>
    <node pkg="topic_tools" exec="relay" name="trajectory_relay">
      <param name="input_topic" value="/planning/trajectory"/>
      <param name="output_topic" value="/planning/scenario_planning/trajectory"/>
    </node>
  </group>
</launch>
