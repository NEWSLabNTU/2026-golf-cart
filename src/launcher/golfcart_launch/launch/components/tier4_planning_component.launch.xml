<?xml version="1.0"?>
<!--
  Planning component for Autoware 2.1.0: autoware_launch's
  component_planning.launch.xml plus two things a golfcart planning preset
  needs, choosing parameter files as well as modules.

  Upstream resolves module_preset inside autoware_planning_config's share
  directory, so a preset there can only switch modules on and off. Here
  module_preset names a file under golfcart_launch/config/planning/preset/,
  included first. Its arg defaults become launch configurations before
  upstream's planning.launch.xml includes its own default preset, and an
  argument that already has a value keeps it, so ours win and the rest fall
  through to upstream's.

  Six parameter files are taken from golfcart_ paths that a preset may set.
  Their defaults are upstream's files, and default_preset.yaml adds nothing, so
  module_preset default is stock Autoware.

  On 1.5.0 this was a full copy of tier4_planning_component with every
  parameter path spelled out; 2.1.0 gives each path an argument default inside
  planning.launch.xml, so this passes only the six. The file name is kept so
  the callers and test_planning_preset.py did not move.
-->
<launch>
  <arg name="module_preset" default="default"/>
  <arg name="planning_setting" default="rule_based" description="planning setting diffusion_planner / rule_based"/>
  <arg name="enable_all_modules_auto_mode" default="false"/>
  <arg name="is_simulation" default="false"/>
  <arg name="use_sim_time" default="false"/>
  <arg name="vehicle_model" default="sample_vehicle"/>
  <arg name="data_path" default="$(env HOME)/autoware_data/ml_models" description="packages data and artifacts directory path"/>

  <!-- External interfaces -->
  <arg name="planning_input_objects_topic_name" default="/perception/object_recognition/objects"/>
  <arg name="planning_input_tracked_objects_topic_name" default="/perception/object_recognition/tracking/objects"/>
  <arg name="planning_input_pointcloud_topic_name" default="/perception/obstacle_segmentation/pointcloud"/>

  <!-- Global parameters -->
  <group scoped="false">
    <include file="$(find-pkg-share autoware_global_parameter_loader)/launch/global_params.launch.py">
      <arg name="use_sim_time" value="$(var use_sim_time)"/>
      <arg name="vehicle_model" value="$(var vehicle_model)"/>
    </include>
  </group>

  <include file="$(find-pkg-share golfcart_launch)/config/planning/preset/$(var module_preset)_preset.yaml"/>
  <let name="golfcart_planning_config_dir" value="$(find-pkg-share autoware_planning_config)/config/scenario_planning"/>
  <arg name="golfcart_common_param_path" default="$(var golfcart_planning_config_dir)/common/common.param.yaml"/>
  <arg name="golfcart_obstacle_stop_param_path" default="$(var golfcart_planning_config_dir)/lane_driving/motion_planning/motion_velocity_planner/obstacle_stop.param.yaml"/>
  <arg name="golfcart_road_user_stop_param_path" default="$(var golfcart_planning_config_dir)/lane_driving/motion_planning/motion_velocity_planner/road_user_stop.param.yaml"/>
  <arg name="golfcart_drivable_area_expansion_param_path" default="$(var golfcart_planning_config_dir)/lane_driving/behavior_planning/behavior_path_planner/drivable_area_expansion.param.yaml"/>
  <arg name="golfcart_goal_planner_param_path" default="$(var golfcart_planning_config_dir)/lane_driving/behavior_planning/behavior_path_planner/goal_planner/goal_planner.param.yaml"/>
  <arg name="golfcart_start_planner_param_path" default="$(var golfcart_planning_config_dir)/lane_driving/behavior_planning/behavior_path_planner/start_planner/start_planner.param.yaml"/>

  <include file="$(find-pkg-share autoware_planning_launch)/launch/planning.launch.xml">
    <arg name="module_preset" value="default"/>
    <arg name="planning_setting" value="$(var planning_setting)"/>
    <arg name="enable_all_modules_auto_mode" value="$(var enable_all_modules_auto_mode)"/>
    <arg name="is_simulation" value="$(var is_simulation)"/>
    <arg name="vehicle_model" value="$(var vehicle_model)"/>
    <arg name="data_path" value="$(var data_path)"/>

    <!-- Input topic parameters -->
    <arg name="input_objects_topic_name" value="$(var planning_input_objects_topic_name)"/>
    <arg name="input_tracked_objects_topic_name" value="$(var planning_input_tracked_objects_topic_name)"/>
    <arg name="input_pointcloud_topic_name" value="$(var planning_input_pointcloud_topic_name)"/>

    <!-- The six a golfcart preset may replace -->
    <arg name="common_param_path" value="$(var golfcart_common_param_path)"/>
    <arg name="motion_velocity_planner_obstacle_stop_module_param_path" value="$(var golfcart_obstacle_stop_param_path)"/>
    <arg name="motion_velocity_planner_road_user_stop_module_param_path" value="$(var golfcart_road_user_stop_param_path)"/>
    <arg name="behavior_path_planner_drivable_area_expansion_param_path" value="$(var golfcart_drivable_area_expansion_param_path)"/>
    <arg name="behavior_path_planner_goal_planner_module_param_path" value="$(var golfcart_goal_planner_param_path)"/>
    <arg name="behavior_path_planner_start_planner_module_param_path" value="$(var golfcart_start_planner_param_path)"/>
  </include>
</launch>
