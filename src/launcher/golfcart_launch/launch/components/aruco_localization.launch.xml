<?xml version="1.0"?>
<!--
  ArUco boards as the sole pose source. Phase 3D-2.

  Brings up the three per-camera detectors, the localizer, gyro_odometer and
  the EKF. Deliberately brings up NO scan matcher, no pointcloud preprocessing
  and no pointcloud map loader.
-->
<launch>
  <arg name="loc_config_path"/>
  <arg name="aruco_tag_map_path"/>
  <arg name="twist_source" default="gyro_odom"/>
  <arg name="camera_names" default="['left','right','rear']"/>
  <arg name="use_sim_detector" default="false"
       description="substitute aruco_sim_detector for the real detectors (phase 3D-6)"/>
  <arg name="detector_config_path"
       default="$(find-pkg-share golfcart_aruco_detector)/config/aruco_detector.param.yaml"/>
  <arg name="detector_debug_overlay" default="false"/>

  <!-- ── detectors, one per camera ───────────────────────────────────────────
       Not in the localization namespace: these are sensing, and they publish
       alongside the camera they belong to. The localizer subscribes to all
       three and solves jointly over whatever they collectively see.

       Subscribes to the COMPRESSED topic. The gscam pipeline is configured
       with `enable_pub_plugins: ["image_transport/compressed"]`, so no raw
       sensor_msgs/Image is published at all — a detector on the raw topic
       waits forever and presents as a camera that sees nothing.
  -->
  <group unless="$(var use_sim_detector)">
    <node pkg="golfcart_aruco_detector" exec="golfcart_aruco_detector"
          name="aruco_detector_left" output="screen">
      <param from="$(var detector_config_path)"/>
      <param name="debug_overlay" value="$(var detector_debug_overlay)"/>
      <remap from="~/input/image/compressed"
             to="/sensing/camera/left/image_raw/compressed"/>
      <remap from="~/input/camera_info" to="/sensing/camera/left/camera_info"/>
      <remap from="~/output/detections" to="/sensing/camera/left/aruco_detections"/>
    </node>

    <node pkg="golfcart_aruco_detector" exec="golfcart_aruco_detector"
          name="aruco_detector_right" output="screen">
      <param from="$(var detector_config_path)"/>
      <param name="debug_overlay" value="$(var detector_debug_overlay)"/>
      <remap from="~/input/image/compressed"
             to="/sensing/camera/right/image_raw/compressed"/>
      <remap from="~/input/camera_info" to="/sensing/camera/right/camera_info"/>
      <remap from="~/output/detections" to="/sensing/camera/right/aruco_detections"/>
    </node>

    <node pkg="golfcart_aruco_detector" exec="golfcart_aruco_detector"
          name="aruco_detector_rear" output="screen">
      <param from="$(var detector_config_path)"/>
      <param name="debug_overlay" value="$(var detector_debug_overlay)"/>
      <remap from="~/input/image/compressed"
             to="/sensing/camera/rear/image_raw/compressed"/>
      <remap from="~/input/camera_info" to="/sensing/camera/rear/camera_info"/>
      <remap from="~/output/detections" to="/sensing/camera/rear/aruco_detections"/>
    </node>
  </group>

  <group>
    <push-ros-namespace namespace="localization"/>

    <!-- ── pose estimator ────────────────────────────────────────────────── -->
    <group>
      <push-ros-namespace namespace="pose_estimator"/>

      <node pkg="golfcart_aruco_localizer" exec="aruco_localizer_node"
            name="aruco_localizer" output="screen">
        <param from="$(var loc_config_path)/aruco_localizer.param.yaml"/>
        <param name="tag_map_path" value="$(var aruco_tag_map_path)"/>

        <remap from="~/input/detections/left"
               to="/sensing/camera/left/aruco_detections"/>
        <remap from="~/input/detections/right"
               to="/sensing/camera/right/aruco_detections"/>
        <remap from="~/input/detections/rear"
               to="/sensing/camera/rear/aruco_detections"/>
        <remap from="~/input/kinematic_state" to="/localization/kinematic_state"/>

        <remap from="~/output/pose_with_covariance"
               to="/localization/pose_estimator/pose_with_covariance"/>
        <remap from="~/output/initialpose" to="/initialpose3d"/>
      </node>
    </group>

    <!-- ── twist estimator ───────────────────────────────────────────────── -->
    <group if="$(eval '\'$(var twist_source)\' == \'gyro_odom\'')">
      <push-ros-namespace namespace="twist_estimator"/>
      <include file="$(find-pkg-share autoware_gyro_odometer)/launch/gyro_odometer.launch.xml">
        <arg name="input_vehicle_twist_with_covariance_topic"
             value="/sensing/vehicle_velocity_converter/twist_with_covariance"/>
        <arg name="input_imu_topic" value="/sensing/imu/imu_data"/>
        <arg name="output_twist_with_covariance"
             value="/localization/twist_estimator/twist_with_covariance"/>
        <arg name="output_twist_with_covariance_raw"
             value="/localization/twist_estimator/twist_with_covariance_raw"/>
      </include>
    </group>

    <!-- ── health monitors ───────────────────────────────────────────────
         Both live inside tier4_localization_launch, which this branch bypasses,
         so neither was running. Both are pose-source agnostic — the error
         monitor reads only /localization/kinematic_state, and the instability
         detector compares the filter output against dead reckoning — so there
         is no reason for ArUco to go without them.

         The error monitor is monitoring-only for now: its ellipse thresholds
         were chosen for a LiDAR pose source, and this repo already records that
         they caused false MRM stops. It publishes its diagnostic but does not
         gate. See config/system/diagnostics/localization-aruco.yaml.
    -->
    <group>
      <include file="$(find-pkg-share autoware_localization_error_monitor)/launch/localization_error_monitor.launch.xml">
        <arg name="input/odom" value="/localization/kinematic_state"/>
        <arg name="param_file" value="$(var loc_config_path)/localization_error_monitor.param.yaml"/>
      </include>
    </group>

    <group>
      <include file="$(find-pkg-share autoware_pose_instability_detector)/launch/pose_instability_detector.launch.xml">
        <arg name="input_odometry" value="/localization/kinematic_state"/>
        <arg name="input_twist" value="/localization/twist_estimator/twist_with_covariance"/>
        <arg name="param_file" value="$(var loc_config_path)/pose_instability_detector.param.yaml"/>
      </include>
    </group>

    <!-- ── fusion ────────────────────────────────────────────────────────── -->
    <group>
      <push-ros-namespace namespace="pose_twist_fusion_filter"/>
      <include file="$(find-pkg-share autoware_ekf_localizer)/launch/ekf_localizer.launch.xml">
        <arg name="param_file" value="$(var loc_config_path)/ekf_localizer.param.yaml"/>
        <arg name="input_initial_pose_name" value="/initialpose3d"/>
        <arg name="input_pose_with_cov_name"
             value="/localization/pose_estimator/pose_with_covariance"/>
        <arg name="input_twist_with_cov_name"
             value="/localization/twist_estimator/twist_with_covariance"/>
        <arg name="output_odom_name" value="/localization/kinematic_state"/>
      </include>
    </group>
  </group>
</launch>
