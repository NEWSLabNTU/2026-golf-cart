<?xml version="1.0"?>
<!--
  One detector node per camera. The localizer subscribes to all of them and
  solves the vehicle pose jointly over whatever they collectively see.

  This lives in golfcart_launch rather than in golfcart_aruco_detector because
  that package is built with ament_cargo, which installs the binary and nothing
  else — no config/, no launch/. Left in the Rust package the files simply do
  not reach install/, and launch reports "Parameter file path is not a file"
  while the node silently runs on its compiled-in defaults. Same reason
  golfcart_vehicle_interface keeps its parameters in golfcart_vehicle_launch.
-->
<launch>
  <arg name="camera_name" description="Names the node and its namespace, e.g. front"/>
  <arg name="image_topic"/>
  <arg name="camera_info_topic"/>
  <arg name="param_file"
       default="$(find-pkg-share golfcart_launch)/config/localization/aruco_detector.param.yaml"/>
  <arg name="debug_overlay" default="false"/>
  <arg name="image_transport" default="compressed"
       description="raw or compressed, spelled as image_transport spells it"/>

  <node pkg="golfcart_aruco_detector" exec="golfcart_aruco_detector"
        name="aruco_detector_$(var camera_name)" output="screen">
    <param from="$(var param_file)"/>
    <param name="debug_overlay" value="$(var debug_overlay)"/>
    <param name="image_transport" value="$(var image_transport)"/>
    <!-- BOTH remaps, and that is not belt and braces. ROS 2 remapping matches
         a whole topic name, so `~/input/image` does not carry
         `~/input/image/compressed` with it: with only the first line here, a
         detector on the compressed transport subscribed to its own private
         `<node>/input/image/compressed` and sat silent forever, looking like a
         camera that sees nothing. Whichever transport is selected, one of these
         two lines is the one that matters. -->
    <remap from="~/input/image" to="$(var image_topic)"/>
    <remap from="~/input/image/compressed" to="$(var image_topic)/compressed"/>
    <remap from="~/input/camera_info" to="$(var camera_info_topic)"/>
  </node>
</launch>
