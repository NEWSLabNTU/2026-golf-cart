<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>golfcart_launch</name>
  <version>0.0.0</version>
  <description>Golf Cart launch and utility package</description>
  <maintainer email="jerry73204@gmail.com">aeon</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake_auto</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <!-- camera.launch.xml, included directly by the is_orin group -->
  <exec_depend>golfcart_sensor_kit_launch</exec_depend>
  <!-- rviz_relay.launch.xml: topic_tools::ThrottleNode, loaded as a component -->
  <exec_depend>topic_tools</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
