<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <!-- Keyboard Control GUI Node -->
  <!--
    This node provides manual control of the vehicle using arrow keys with a GUI.
    GUI includes topic mode selection - no need for separate launch files!

    Topic Modes (selectable in GUI):
      - Direct: /control/command/* (default, drives golfcart_vehicle_interface)
      - Custom: user-supplied topic names

    Always publishes:
      - /control/gate_mode_cmd  (kept for vehicle_cmd_gate compatibility,
        ignored by golfcart_vehicle_interface)

    Usage:
      1. Launch Golf Cart: just launch
      2. Run this: ros2 launch control_test keyboard_control.launch.xml
      3. Click on the GUI window to focus it
      4. Have the driver switch the vehicle to autonomous on its own
         controls; golfcart_vehicle_interface transmits commands only while
         all four VCU subsystem states report autonomous. Check
         /vehicle/status/control_mode (or the drive TUI: just tool tui)
      5. Press 'x' for DRIVE gear
      6. Use arrow keys to control

    ⚠️ Requires GUI: Needs X11 display (DISPLAY environment variable)
  -->

  <node pkg="control_test" exec="keyboard_control" name="keyboard_control_node" output="screen">
    <!-- Load configuration parameters -->
    <param from="$(find-pkg-share control_test)/config/keyboard_control.yaml"/>
  </node>
</launch>
