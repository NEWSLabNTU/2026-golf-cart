<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>control_test</name>
  <version>1.0.0</version>
  <description>Control system testing package with manual control and testing nodes</description>
  <maintainer email="dev@golfcart.org">Golf Cart Team</maintainer>
  <license>Apache-2.0</license>

  <!--
    python3-setuptools, not ament_python. ament_python is a build type and
    belongs in the export block below; there is no package by that name, so
    rosdep reported it as unresolvable on every run. setup.py is what actually
    needs installing.
  -->
  <buildtool_depend>python3-setuptools</buildtool_depend>

  <depend>rclpy</depend>
  <depend>tier4_control_msgs</depend>
  <depend>tier4_external_api_msgs</depend>
  <depend>autoware_control_msgs</depend>
  <depend>autoware_vehicle_msgs</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
