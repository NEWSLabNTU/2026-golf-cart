<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>golfcart_aruco_detector</name>
  <version>0.1.0</version>
  <description>
    ArUco marker detection: images in, rectified corners and per-marker candidate
    poses out. No map, no TF, no map-frame pose — that is the localizer's job.

    Vendored from LCTK (rust/aruco-config, rust/aruco-detector, rust/aruco-locator,
    ros/aruco_locator_node) and merged into one package. LCTK keeps its own copy
    for calibration; see docs/roadmaps/3-indoor-d5-detector.md for what was
    dropped in the merge and why.
  </description>
  <maintainer email="dev@golfcart.org">Golf Cart Team</maintainer>
  <license>Apache-2.0</license>

  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>aruco_detection_msgs</depend>
  <!--
    rclrs is deliberately absent, like rclrs_image_transport below. It is a
    crates.io crate (Cargo.toml pins `rclrs = "*"`), not a ROS package: nothing
    named rclrs is installed under /opt/ros or /opt/autoware, and rosdep has no
    rule for it. Declaring it asked rosdep for a package that cannot exist, and
    it was reported as unresolvable on every run. colcon-cargo-ros2 does not
    need it either; its Cargo/package.xml cross-check only looks at interface
    packages.
  -->

  <!--
    rclrs_image_transport is deliberately absent. It is not a package in this
    workspace any more: it lives at github.com/jerry73204/rclrs_image_transport
    and Cargo.toml pins it to a commit. Declaring it here would ask colcon and
    rosdep to find a package that is not there.
  -->

  <export>
    <build_type>ament_cargo</build_type>
  </export>
</package>
