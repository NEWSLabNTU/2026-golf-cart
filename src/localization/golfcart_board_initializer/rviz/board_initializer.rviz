Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Raw scan1
        - /Board points1
        - /Board pose1
        - /Rejected clusters1
    Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Cell Size: 1
      Plane Cell Count: 20
      Color: 160; 160; 164
      Enabled: true
      Reference Frame: base_link
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
      Show Names: true
      Marker Scale: 1
    - Class: rviz_default_plugins/PointCloud2
      Name: Raw scan
      Topic:
        Value: /sensing/lidar/top/pointcloud_raw_ex
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Best Effort
      Enabled: true
      Style: Points
      Size (Pixels): 2
      # Colour by intensity, so the retroreflector band separates visually:
      # 0-100 is every diffuse surface, 101-255 is reserved for retroreflectors.
      Color Transformer: Intensity
      Channel Name: intensity
      Use rainbow: true
      Autocompute Intensity Bounds: false
      Min Intensity: 0
      Max Intensity: 255
      Decay Time: 0
    - Class: rviz_default_plugins/PointCloud2
      Name: Board points
      Topic:
        Value: /board_pose_initializer/debug/board_points
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Enabled: true
      Style: Spheres
      Size (m): 0.05
      Color Transformer: FlatColor
      Color: 0; 255; 0
      Decay Time: 0
    # Off by default: a latched PoseStamped cannot be retracted, so after a
    # failed attempt this display keeps drawing the previous detection. The
    # green arrow in Rejected clusters carries the same pose and is cleared
    # with the rest of the markers.
    - Class: rviz_default_plugins/Pose
      Name: Board pose
      Topic:
        Value: /board_pose_initializer/debug/board_pose
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Enabled: false
      Shape: Axes
      Axes Length: 0.5
      Axes Radius: 0.05
    - Class: rviz_default_plugins/MarkerArray
      Name: Rejected clusters
      Topic:
        Value: /board_pose_initializer/debug/rejected
        Depth: 5
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Enabled: true
      Namespaces:
        {}
    - Class: rviz_default_plugins/PoseWithCovariance
      Name: Initial pose (dry run)
      Topic:
        Value: /board_pose_initializer/debug/initial_pose
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Enabled: true
      Covariance:
        Value: true
        Position:
          Alpha: 0.3
          Color: 204; 51; 204
        Orientation:
          Alpha: 0.5
          Color: 255; 255; 127
      Shape: Arrow
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: base_link
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 13
      Focal Point:
        X: 3.0
        Y: 0
        Z: 0.4
      Pitch: 0.28
      Yaw: 3.14
      Near Clip Distance: 0.01
    Saved: ~
Window Geometry:
  Height: 900
  Width: 1400
  Displays:
    collapsed: false
