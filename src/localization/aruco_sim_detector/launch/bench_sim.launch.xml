<?xml version="1.0"?>
<!--
  Phase 3D-3 stage one: scripted ground truth into synthetic detections.
  No Autoware simulator, no map server, no vehicle. Runs in seconds.

  Example:
    ros2 launch aruco_sim_detector bench_sim.launch.xml \
      tag_map_path:=$(ros2 pkg prefix golfcart_aruco_localizer)/share/\
golfcart_aruco_localizer/config/example_tag_map.yaml
-->
<launch>
  <!-- Defaults to the bench fixture, whose boards have deliberately spread
       normals. Point it at example_tag_map.yaml to exercise the coplanar case,
       where publishing nothing is the correct behaviour. -->
  <arg name="tag_map_path"
       default="$(find-pkg-share aruco_sim_detector)/config/bench_tag_map.yaml"/>
  <arg name="pattern" default="straight"/>
  <arg name="localizer_log_level" default="info"/>
  <arg name="speed" default="1.0"/>
  <arg name="corner_sigma_px" default="0.3"/>
  <arg name="localizer_config"
       default="$(find-pkg-share golfcart_aruco_localizer)/config/aruco_localizer.param.yaml"/>
  <arg name="sim_config"
       default="$(find-pkg-share aruco_sim_detector)/config/sim_detector.param.yaml"/>

  <node pkg="aruco_sim_detector" exec="sim_trajectory_publisher_node"
        name="sim_trajectory_publisher" output="screen">
    <param name="pattern" value="$(var pattern)"/>
    <param name="speed" value="$(var speed)"/>
    <remap from="~/output/ground_truth" to="/simulation/ground_truth/kinematic_state"/>
  </node>

  <node pkg="aruco_sim_detector" exec="aruco_sim_detector_node"
        name="aruco_sim_detector" output="screen">
    <param from="$(var sim_config)"/>
    <param name="tag_map_path" value="$(var tag_map_path)"/>
    <param name="corner_sigma_px" value="$(var corner_sigma_px)"/>
    <remap from="~/input/ground_truth" to="/simulation/ground_truth/kinematic_state"/>
  </node>

  <!-- The node under test. Launched here so the whole loop is one command:
       without it the bench produces detections that nothing consumes, which
       looks like a working run and tests nothing. -->
  <node pkg="golfcart_aruco_localizer" exec="aruco_localizer_node"
        name="aruco_localizer" output="screen"
        args="--ros-args --log-level $(var localizer_log_level)">
    <param from="$(var localizer_config)"/>
    <param name="tag_map_path" value="$(var tag_map_path)"/>
    <!-- Must match the sim's cameras, or the localizer subscribes to topics
         nobody publishes and reports DEAD_RECKONING while detections flow. -->
    <param name="camera_names" value="[left, right, rear]"/>
    <remap from="~/input/detections/left" to="/aruco_sim_detector/output/detections/left"/>
    <remap from="~/input/detections/right" to="/aruco_sim_detector/output/detections/right"/>
    <remap from="~/input/detections/rear" to="/aruco_sim_detector/output/detections/rear"/>
    <remap from="~/input/kinematic_state" to="/simulation/ground_truth/kinematic_state"/>
  </node>
</launch>
