<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>aruco_sim_detector</name>
  <version>0.1.0</version>
  <description>
    Synthetic ArUco detections from a known vehicle pose.

    Turns a ground-truth pose plus the tag map into ArucoDetectionArray
    messages, as if the cameras had seen the boards. This is the localizer's
    test fixture: it supplies exact ground truth, and faults that can be dialled
    in — a displaced board, a blackout, a coplanar-only view — which no rosbag
    provides.

    Phase 3D-3.
  </description>
  <maintainer email="dev@golfcart.org">Golf Cart Team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake_auto</buildtool_depend>

  <depend>aruco_detection_msgs</depend>
  <depend>eigen</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>golfcart_aruco_localizer</depend>
  <depend>nav_msgs</depend>
  <depend>rclcpp</depend>
  <depend>tf2_eigen</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>visualization_msgs</depend>
  <depend>libopencv-dev</depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_cmake_copyright</test_depend>
  <test_depend>ament_cmake_xmllint</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
