Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Cell Size: 1
      Plane Cell Count: 20
    - Class: rviz_default_plugins/TF
      Enabled: true
      Name: TF
    - Class: golfcart_sphere_view/SphereView
      Enabled: true
      Name: SphereView
      Centre Frame: base_link
      Radius: 10
      Grid Step: 1
  Global Options:
    Fixed Frame: base_link
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 32
      Focal Point: {X: 0, Y: 0, Z: 0}
      Pitch: 0.3
      Yaw: 3.0
      Name: Current View
