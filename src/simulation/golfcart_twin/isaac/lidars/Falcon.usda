    custom float omni:sensor:Core:rangeResolutionM = 0.004
    custom token omni:sensor:Core:rayType = "IDEALIZED"
    custom uint omni:sensor:Core:reportRateBaseHz = 10
    custom token omni:sensor:Core:rotationDirection = "CW"
    custom uint omni:sensor:Core:scanRateBaseHz = 10
    custom token omni:sensor:Core:scanType = "SOLID_STATE"
    custom bool omni:sensor:Core:skipDroppingInvalidPoints = 0
    custom uint omni:sensor:Core:stateResolutionStep = 1
    custom string omni:sensor:modelName = "Falcon"
    custom float omni:sensor:tickRate = 10
}

