<?xml version="1.0"?>
<!--
  The cart's own Autoware against the NTU twin on Isaac Sim (roadmap 10): golfcart_launch's
  logging simulation (drivers off, sim time) with what the first drive on 118 (2026-11-07)
  needed. aib's runner plays the sensors and the vehicle interface on the Isaac side.

    play_launch launch golfcart_twin twin_autoware.launch.xml   (web-addr 127.0.0.1:8081)

  map_path defaults to $TWIN_MAP. Give play_launch a web port other than the world launch's
  (8080 by default; scripts/twin/setup.bash shows the commands).

  The DDS settings are the caller's, not this file's: ROS_DOMAIN_ID, RMW_IMPLEMENTATION and
  CYCLONEDDS_URI come from scripts/twin/setup.bash, and both sides must share them (this
  package's config/cyclonedds-unicast-lo.xml: loopback multicast is off on 118, so the cart's
  loopback.xml discovers nothing there).
-->
<launch>
  <arg name="map_path" default="$(env TWIN_MAP '')"
       description="The twin's map directory (default $TWIN_MAP): lanelet2_map.osm, pointcloud_map/ with pointcloud_map_metadata.yaml, map_projector_info.yaml (MGRS 51RUH)."/>
  <arg name="imu_source" default="xsens"
       description="xsens: the sim publishes /sensing/imu/xsens/imu_raw in imu_link. It has no ZED IMU and no zed_imu_link frame, so zed does not work here."/>
  <arg name="data_path" default="$(env AUTOWARE_DATA ./data/autoware_data)"
       description="Autoware's model directory, writable (TensorRT caches engines there). Defaults to $AUTOWARE_DATA, else ./data/autoware_data from the repository root. Without it CenterPoint does not load."/>
  <arg name="speed_limit" default="2.5"
       description="Planning speed default in m/s (golfcart_launch's planning_speed_limit.py, latched). 2.5 is the demo cap; empty keeps Autoware's max_vel."/>
  <arg name="camera_model" default="none"
       description="none: Isaac publishes the camera topics itself. The sensor kit starts its GMSL camera nodes whatever launch_driver says, and they die with no nvv4l2camerasrc off the cart."/>
  <arg name="launch_perception" default="true" description="Launch perception"/>
  <!-- Detection: CenterPoint tiny merged with the clustering detector, not CenterPoint alone.
       The cart's lidar_only preset runs CenterPoint only (the multi-channel tracker merger reads
       nothing else), and in the twin CenterPoint scores a pedestrian 0.37-0.56 while it walks
       and drops it once it stands: 4400 lidar points stood in the cart's lane, 4.6 m ahead,
       with no object, and the cart crept to 0.95 m of it (showcase_pedestrian, 118,
       2026-11-09). With the single merged input the clustering detector reports it as an
       unknown object and the cart holds. Autoware's own alternative; the preset is unchanged. -->
  <arg name="use_lidar_rule_detector" default="true"
       description="Run the clustering detector beside CenterPoint (the cart's preset: false)"/>
  <arg name="use_multi_channel_tracker_merger" default="false"
       description="false: the tracker reads the merged CenterPoint + clustering objects (the cart's preset: true, CenterPoint only)"/>
  <!-- Not "rviz": the include below sets rviz:=false, and an XML include's arguments are not
       scoped (ros2 launch on Humble and play_launch alike), so that value would reach this
       file's scope and the demo RViz would never start (118, 2026-11-07). -->
  <arg name="demo_rviz" default="true" description="The twin demo RViz (rviz/twin_demo.rviz) with the vehicle parameters and sim time"/>

  <include file="$(find-pkg-share golfcart_launch)/launch/logging_simulation.launch.yaml">
    <arg name="map_path" value="$(var map_path)"/>
    <arg name="imu_source" value="$(var imu_source)"/>
    <arg name="camera_model" value="$(var camera_model)"/>
    <arg name="data_path" value="$(var data_path)"/>
    <arg name="launch_perception" value="$(var launch_perception)"/>
    <arg name="use_lidar_rule_detector" value="$(var use_lidar_rule_detector)"/>
    <arg name="use_multi_channel_tracker_merger" value="$(var use_multi_channel_tracker_merger)"/>
    <!-- the stack's own RViz is the stock config; the demo's is started below -->
    <arg name="rviz" value="false"/>
  </include>

  <!-- The speed cap. logging_simulation has no planning_speed_limit argument (golfcart.launch.yaml
       does); this is the same node. Latched, so a velocity limit selector that starts later
       still receives it. On 118 a cap published by hand did not hold and the cart reached 3.0 m/s. -->
  <group if="$(eval &quot;'$(var speed_limit)' != ''&quot;)">
    <node pkg="golfcart_launch" exec="planning_speed_limit.py" name="planning_speed_limit" namespace="planning" output="screen">
      <param name="max_velocity" value="$(var speed_limit)"/>
      <param name="use_sim_time" value="true"/>
    </node>
  </group>

  <!-- RViz needs the vehicle parameters, or it drops the whole config ("Statically typed
       parameter 'wheel_radius' must be initialized"). -->
  <node pkg="rviz2" exec="rviz2" name="twin_rviz" output="screen" if="$(var demo_rviz)"
        args="-d $(find-pkg-share golfcart_twin)/rviz/twin_demo.rviz">
    <param from="$(find-pkg-share golfcart_vehicle_description)/config/vehicle_info.param.yaml"/>
    <param name="use_sim_time" value="true"/>
  </node>
</launch>
