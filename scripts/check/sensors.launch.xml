<launch>
  <!-- Arguments to toggle each sensor -->
  <arg name="launch_lidar"  default="false"/>
  <arg name="launch_gnss"   default="false"/>
  <arg name="launch_camera" default="false"/>

  <!-- Capture this launch file's directory before any <include> shifts $(dirname). -->
  <arg name="rviz_config" default="$(dirname)/sensors.rviz"/>

  <!-- ── RViz ────────────────────────────────────────────────────────────── -->
  <node pkg="rviz2" exec="rviz2" name="rviz2_sensors" args="-d $(var rviz_config)"/>

  <!-- ── Velodyne VLP-32C LiDAR ──────────────────────────────────────────── -->
  <group if="$(var launch_lidar)">
    <include file="$(find-pkg-share nebula_ros)/launch/velodyne_launch_all_hw.xml">
      <arg name="sensor_model" value="VLP32"/>
      <arg name="launch_hw" value="true"/>
      <arg name="config_file" value="$(find-pkg-share golfcart_sensor_kit_launch)/config/VLP32.param.yaml"/>
    </include>
  </group>

    <!-- ── Seyond Falcon LiDAR ──────────────────────────────────────────── -->
    <group if="$(var launch_lidar)">
    <!-- <include file="$(find-pkg-share seyond)/start_with_config.py"> -->
    <include file="$(find-pkg-share golfcart_sensor_kit_launch)/launch/seyond_start.py">
      <!-- <arg name="config_path" value="$(find-pkg-share golfcart_sensor_kit_launch)/config/seyond.param.yaml"/> -->
    </include>
  </group>

  <!-- ── u-blox ZED-F9P GNSS ─────────────────────────────────────────────── -->
  <!-- Same driver, same rover configuration as gnss.launch.xml, minus
       gnss_poser and the NTRIP client: this checks that the receiver talks,
       not that it localizes. The file it used to load, c94_f9p_rover.yaml
       under the ublox_gps share directory, never existed there. -->
  <group if="$(var launch_gnss)">
    <node pkg="ublox_gps" name="ublox" exec="ublox_gps_node" respawn="true" respawn_delay="1.0">
      <remap from="~/fix" to="~/nav_sat_fix"/>
      <param from="$(find-pkg-share golfcart_sensor_kit_launch)/config/ublox_f9p.yaml"/>
    </node>
  </group>

  <!-- ── GMSL Cameras (gmslcam, via the sensor kit's own camera.launch.xml) ── -->
  <!--
    The kit's launch file, not a copy of its nodes. This file used to carry its
    own three camera nodes and drifted: it still remapped a raw image topic that
    had not existed since the pipeline went JPEG. Pushing "sensing" here is what
    tier4_sensing_component does above sensing.launch.xml, so the topics come out
    at /sensing/camera/<cam>/..., exactly as in the full stack.
  -->
  <arg name="capture_profile" default="nvv4l2camerasrc"
       description="a directory in the kit's config/camera_capture/; videotestsrc needs no hardware"/>
  <group if="$(var launch_camera)">
    <push-ros-namespace namespace="sensing"/>
    <include file="$(find-pkg-share golfcart_sensor_kit_launch)/launch/camera.launch.xml">
      <arg name="camera_model" value="gmslcam"/>
      <arg name="capture_profile" value="$(var capture_profile)"/>
    </include>
  </group>

</launch>
