	branch = main
# No branch recorded for zed-ros2-wrapper on purpose. It is pinned to the v5.4.1
# tag because that is the ZED SDK installed on the vehicles, and recording a
# branch would invite `git submodule update --remote` to walk it off that tag and
# onto a release the SDK does not match.
[submodule "src/sensor_component/external/zed-ros2-wrapper"]
	path = src/sensor_component/external/zed-ros2-wrapper
	url = https://github.com/stereolabs/zed-ros2-wrapper.git
[submodule "src/localization/reflective_pose_detector"]
	path = src/localization/reflective_pose_detector
	url = https://github.com/NEWSLabNTU/reflector-pose-init.git
	branch = main
[submodule "src/sensing/cuda_pointcloud_filters"]
	path = src/sensing/cuda_pointcloud_filters
	url = https://github.com/NEWSLabNTU/cuda_pointcloud_filters.git
	branch = main
# ublox_f9p_ws is a colcon workspace, not a package: the u-blox driver itself
# (ublox, ublox_gps, ublox_msgs, ublox_serialization) is ITS submodule at
# src/ublox, so this one needs `--recursive`, which `just checkout` passes.
# Without it the directory is empty and `ublox_gps` is provided by nothing.
[submodule "src/sensor_component/external/ublox_f9p_ws"]
	path = src/sensor_component/external/ublox_f9p_ws
	url = https://github.com/NEWSLabNTU/ublox_f9p_ws.git
[submodule "src/sensor_component/external/gmslcam"]
	path = src/sensor_component/external/gmslcam
	url = https://github.com/NEWSLabNTU/gmslcam.git
	branch = main
