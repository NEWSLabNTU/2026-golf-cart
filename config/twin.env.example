# Host settings for the Isaac twin demo (scripts/twin/twin.sh, scripts/twin/setup.bash).
# Copy to config/twin.env (git-ignored) and fill in this host's paths:
#     cp config/twin.env.example config/twin.env      # `scripts/twin/twin.sh setup` does it
# Then `scripts/twin/twin.sh doctor` says what is still missing.

# scenario-world-bridge checkout, built (`twin.sh setup` clones and builds it when absent)
TWIN_SWB=$HOME/repos/scenario-world-bridge
# Isaac Sim 6.1 (swb's src/swb_isaac_world/scripts/install_isaac.sh installs it here)
ISAAC_ROOT=/path/to/isaac-sim
# The NTU twin's map directory, on a local disk (not the NAS): lanelet2_map.osm,
# pointcloud_map/, map_projector_info.yaml, isaac/world.yaml
TWIN_MAP=/path/to/ntu-twin/map
# The Isaac asset set's vehicles and walkers (swb's carla-usd/vehicles): the scenarios' NPCs
SWB_VEHICLE_USD=/path/to/carla-usd/vehicles
# Autoware's models, writable (CenterPoint's TensorRT engines are built here once)
AUTOWARE_DATA=$HOME/autoware_data
# A TensorRT 10.8 runtime (swb's `just setup-tensorrt`); empty: the host's, engines rebuild each start
AUTOWARE_TENSORRT_LIB=

# ROS domains: the cart's side, and SSv2 + the bridge (at most 57 each)
TWIN_DOMAIN=1
TWIN_SCENARIO_DOMAIN=2
# Isaac's window (empty: headless) and the GPU it renders on
TWIN_DISPLAY=$DISPLAY
TWIN_GPU=0

# swb's ports; move them when another stack on this host holds the defaults (5555, 5560, 5590)
#SSV2_PORT=5575
#AGENT_PORT=5580
#ISAAC_PORT=5590
