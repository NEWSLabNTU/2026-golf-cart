# editor
*.swp
*.swo
*~
.*~
\#*#

# colcon. Not anchored to the repo root: running colcon from inside a package
# creates a nested build/ and install/ there, and those were once committed.
build/
log/
install/

# python
__pycache__/
*.pyc
*.pyo

# tmp
tmp/

# play records
play_log/

# rosbags + raw CAN logs
rosbags/

# downloaded datasets
data/leodrive-busood/

# Writable view of Autoware's packaged model data: symlinks into
# /opt/autoware/<ver>/data plus the TensorRT .engine files built beside them.
# Generated by `just setup-autoware-data`; the engines are GPU- and
# TensorRT-version specific, so they are never portable between machines.
data/autoware_data/

# per-machine host identity: one word, `master` or `orin`. Deliberately not
# tracked — which machine this checkout is on is a property of the machine.
config/host
.golfcart-host

# once-only warning stamps dropped by scripts/env.sh
.envrc.sysctl-warned
.envrc.host-warned

# Progress deck and its media live outside the project, in
# ~/Downloads/golfcart-progress-slides. They were 25 MB of binaries that churned
# on every edit, and none of it is part of the system.
docs/reports/
scripts/report/

# Generated by scripts/sim/cameras.sh: synthetic camera configs and feeder logs.
.sim-cameras/

# Screencasts and merged bags from test runs. Run data, not system source, and
# data/captures alone is 24 MB of video that does not delta.
data/captures/
# No trailing slash: this one is a symlink to a map outside the repo, and a
# trailing slash matches only real directories.
data/ntu-campus-merged

# Typst output. The .typ beside it is the source and is tracked; no .pdf has
# ever been committed here. Each carries its own `typst compile` line.
docs/design/*.pdf

# Resource-measurement archives pulled off the NAS for analysis. 355 MB
# unpacked per capture, and the source of record is the NAS, not this repo.
data/measurements/
