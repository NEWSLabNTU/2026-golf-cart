// Sensor wiring across the two machines.
//
//   dot -Tpng -Gdpi=150 sensor_wiring.dot -o sensor_wiring.png
//
// Ownership is taken from config/recording/{master,orin}_topics.txt, which is
// the authoritative record of which host publishes what.
//
// LABELS ARE DELIBERATELY SHORT. An earlier version put the interface, the IP
// address, the topic names and the reason-for-placement inside the node cards,
// which forced the font down until nothing was readable from the back of a
// room. Anything that is not the device's name now lives on an edge or in what
// the presenter says out loud. Do not put it back.
//
// Facts that are no longer written on the picture:
//   - Velodyne 192.168.7.10, Falcon UDP 8010
//   - the ZED IMU topic is /sensing/camera/zed/imu/data at 100 Hz
//   - the master starts and stops the orin's unit over ssh
//   - the card colours: the legend for those lives in the SLIDE, in Typst, not
//     in this file. Text inside the picture is scaled down with the picture;
//     text beside it on the slide stays at body size.
//   - the u-blox is on the Orin because the Advantech has no free USB port --
//     keyboard, mouse, phone tethering, external disk. See notes-usb-ports.md
//   - the Xsens cable is broken and being remade; the stack runs on the ZED's
//     built-in IMU meanwhile, so the IMU in use crosses the Ethernet link

digraph sensors {
  rankdir=LR;
  bgcolor="white";
  compound=true;
  nodesep=0.14;
  ranksep=0.62;
  fontname="Helvetica";
  node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=34,
         color="#B7C7DA", fillcolor="#f4f8fb", penwidth=1.3,
         margin="0.22,0.13"];
  edge  [fontname="Helvetica", fontsize=30, color="#5a5a5a", arrowsize=0.8];

  // ── Advantech ─────────────────────────────────────────────────────────────
  subgraph cluster_master {
    label="Advantech";
    fontsize=38; fontname="Helvetica-Bold";
    color="#4285F4"; penwidth=1.8; style=rounded; bgcolor="#fbfdff";
    margin=9;

    vlp    [label="Velodyne VLP-32C"];
    falcon [label="Seyond Falcon"];
    cams   [label="3 × GMSL cameras"];
    xsens  [label="Xsens IMU\ncable being remade", color="#FFAB40",
            fillcolor="#FFF6E8", fontcolor="#A85F00",
            style="rounded,filled,dashed"];
    vcu    [label="VCU", fillcolor="#E4F4F6", color="#0097A7",
            fontcolor="#00707C"];

    adv    [label="Autoware stack", shape=box, style="filled",
            fillcolor="#4285F4", fontcolor="white", color="#4285F4",
            fontsize=35];

    cams   -> xsens [style=invis];
    cams   -> vcu   [style=invis];

    vlp    -> adv [label="  ethernet"];
    falcon -> adv [label="  ethernet"];
    cams   -> adv [label="  MIPI"];
    xsens  -> adv [label="  can1", color="#FFAB40",
                   fontcolor="#A85F00", style=dashed];
    vcu    -> adv [label="  can0", dir=both, color="#0097A7",
                   fontcolor="#00707C", penwidth=1.6];
  }

  // ── Orin ──────────────────────────────────────────────────────────────────
  subgraph cluster_orin {
    label="AGX Orin";
    fontsize=38; fontname="Helvetica-Bold";
    color="#4285F4"; penwidth=1.8; style=rounded; bgcolor="#fbfdff";
    margin=9;

    zed  [label="ZED X\nstereo + IMU"];
    zedl [label="ZEDLink card"];
    gnss [label="u-blox GNSS"];

    orin [label="sensor drivers", shape=box, style="filled",
          fillcolor="#4285F4", fontcolor="white", color="#4285F4",
          fontsize=35];

    zed  -> zedl;
    zedl -> orin [label="  PCIe"];
    gnss -> orin [label="  USB"];
  }

  // ── the virtual link ──────────────────────────────────────────────────────
  // Not a cable. The IMU the stack actually uses crosses it, and so does the
  // GNSS fix -- which is why its latency matters to localization. Wired
  // Ethernet, not wifi.
  orin -> adv [label="  DDS over Ethernet\l  IMU, camera, GNSS\l",
               style=bold, color="#4285F4", fontcolor="#4285F4",
               penwidth=2.4, constraint=false];
}
