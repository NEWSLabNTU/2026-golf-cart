// Slide: how the vehicle interface was built. A chain, so draw the chain --
// vertically, because horizontally five boxes make a 13:1 strip whose text is
// unreadable at slide scale. Vertical leaves the right half of the slide for
// prose.
//   dot -Tpng -Gdpi=150 vcu_lineage.dot -o vcu_lineage.png
digraph lineage {
  rankdir=TB; bgcolor="white"; nodesep=0.3; ranksep=0.45;
  fontname="Helvetica";
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=14,
        color="#B7C7DA", fillcolor="#f4f8fb", penwidth=1.2, margin="0.26,0.16",
        width=3.6];
  edge [color="#4285F4", arrowsize=0.9, penwidth=1.6];

  a [label="Turing Drive\nCAN test script", fillcolor="#eef2f6"];
  b [label="+ our safety rules", color="#0097A7", fillcolor="#E4F4F6",
     fontcolor="#00707C", penwidth=1.6];
  c [label="drove the vehicle", fillcolor="#eef2f6"];
  d [label="golfcart_vehicle_interface", shape=box, style="filled",
     fillcolor="#4285F4", fontcolor="white", color="#4285F4"];
  e [label="test suite"];

  a -> b -> c -> d -> e;
}
