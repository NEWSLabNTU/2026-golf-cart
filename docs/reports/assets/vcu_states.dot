// Slide: the VCU decides engage, and one transition we cannot trigger.
// Two lanes, three columns. The sentence about what the interface does while
// waiting belongs in the slide prose, not in a node -- as a node it stretched
// the figure to a 9:1 strip that no 16:9 slide can use.
//   dot -Tpng -Gdpi=150 vcu_states.dot -o vcu_states.png
digraph vcu {
  rankdir=LR; bgcolor="white"; nodesep=0.55; ranksep=1.5;
  fontname="Helvetica";
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=13,
        color="#B7C7DA", fillcolor="#f4f8fb", penwidth=1.2, margin="0.24,0.16"];
  edge [fontname="Helvetica", fontsize=11, color="#5a5a5a", arrowsize=0.8];

  { rank=same;
    i1 [label="MTR · EPS\nInvalid"];
    i2 [label="BRK · Drv\nInvalid", color="#DB4437", fillcolor="#FBE9E7",
        fontcolor="#C5372C", penwidth=1.7];
  }
  { rank=same;
    m1 [label="Manual"];
    m2 [label="Manual"];
  }
  auto [label="Autonomous", fillcolor="#E4F4F6", color="#0097A7",
        fontcolor="#00707C", penwidth=1.7];

  i1 -> m1 [label="  any ADS frame\l  latches\l",
            color="#0097A7", fontcolor="#00707C", penwidth=1.5];
  i2 -> m2 [label="  brake pedal\l  not reproducible\l  from CAN\l",
            color="#DB4437", fontcolor="#C5372C", style=bold, penwidth=1.9];
  m1 -> auto [label="  driver's own\l  controls\l"];
  m2 -> auto;
}
