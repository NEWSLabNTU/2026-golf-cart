#!/bin/bash
# Golf Cart environment configuration for direnv.
#
# All of the actual logic lives in scripts/env.sh so that direnv shells and bare
# shells (`source scripts/env.sh`) cannot drift apart. This file only adds the
# direnv-specific parts: telling direnv which files to watch for changes.

watch_file scripts/env.sh
watch_file .golfcart-host
watch_file install/setup.bash

# direnv evaluates .envrc with the working directory set to its own directory.
if [ -f "$(pwd)/scripts/env.sh" ]; then
    source "$(pwd)/scripts/env.sh"
else
    echo "ERROR: scripts/env.sh not found; environment not configured." >&2
fi
